<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- VersionTests, LicenseHeaderTests and RepoInvariantTests find the project folder from
         [CallerFilePath]. A CI build (ContinuousIntegrationBuild, Directory.Build.props) maps
         source paths to /_/ by default, and those tests would then read from a folder that
         does not exist; the shipped assemblies keep the mapping. -->
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MindfulnessReminder.Core\MindfulnessReminder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
