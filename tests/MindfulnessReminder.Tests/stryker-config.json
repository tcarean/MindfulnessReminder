{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/stryker-config.schema.json",
  "stryker-config": {
    "project": "MindfulnessReminder.Core.csproj",
    "reporters": ["html", "progress", "json"],
    "thresholds": { "high": 90, "low": 80, "break": 0 },
    "ignore-methods": ["ToString", "GetHashCode"],
    "concurrency": 4
  }
}
