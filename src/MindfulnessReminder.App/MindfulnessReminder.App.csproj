<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>

    <!-- The hybrid: WPF for the reminder window, Windows Forms purely for NotifyIcon,
         which has no WPF equivalent in the BCL. Both are in the WindowsDesktop shared
         framework, so this adds no external dependency. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>MindfulnessReminder</AssemblyName>
    <RootNamespace>MindfulnessReminder.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- GPLv3 wants a copy of the licence to travel with every copy of the program, and
         About tells the user it is "next to the executable" - so it has to actually be
         there, in the build output and in whatever gets published from it. -->
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindfulnessReminder.Core\MindfulnessReminder.Core.csproj" />
  </ItemGroup>

</Project>
