<Window x:Class="MindfulnessReminder.App.BreakWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mindfulness Reminder"
        Width="440" Height="260"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="30,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="#2A7A6E"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33917F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#21645A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#8FD6C6" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margin leaves room for the drop shadow inside the transparent window. -->
    <Border Margin="18"
            CornerRadius="16"
            Background="#FFFDFCFA">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Direction="270"
                              Color="#000000" Opacity="0.30" />
        </Border.Effect>

        <Grid Margin="36,32,36,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Ellipse Grid.Row="0"
                     Width="14" Height="14"
                     HorizontalAlignment="Center"
                     Fill="#2A7A6E" />

            <!--
                No Text here: the message is a setting, and the code-behind fills it in
                from whichever of the two reminders this is.

                The window is a fixed size, placed by hand on the primary monitor, and the
                message can run to three lines at this type size, which is one more than
                fits above the button. The Viewbox scales the text DOWN when that happens
                and never up, so the default message is drawn exactly as it always was and
                a long one shrinks to fit instead of running into the Close button. The
                explicit Width on the TextBlock is what makes it wrap inside the Viewbox at
                all; a Viewbox measures its child with unlimited space otherwise.
            -->
            <Viewbox Grid.Row="1"
                     Margin="0,22,0,14"
                     Stretch="Uniform"
                     StretchDirection="DownOnly"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <TextBlock x:Name="MessageText"
                           Width="332"
                           FontFamily="Segoe UI Light, Segoe UI"
                           FontSize="30"
                           Foreground="#1D2B28"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </Viewbox>

            <!--
                Deliberately NOT IsDefault. The reminder now appears in the middle of work,
                not only on a freshly unlocked desktop, and it takes the focus when it does,
                so the very next Enter would have dismissed it and been swallowed on its way
                out of whatever was being typed. See OnPreviewKeyDown in the code-behind.
            -->
            <Button Grid.Row="2"
                    x:Name="CloseButton"
                    Content="Close"
                    Style="{StaticResource CloseButtonStyle}"
                    HorizontalAlignment="Center"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </Grid>
    </Border>
</Window>
