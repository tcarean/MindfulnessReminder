<!--
    The dark palette and the control templates that go with it.

    This dictionary is merged into SettingsWindow ALONE, never into Application.Resources.
    The implicit styles below carry no x:Key, so an application-wide merge would repaint
    BreakWindow too, and the reminder is deliberately left on its light card. Scoping the
    merge to the one window that wants it makes that structural rather than a thing to
    remember.

    Every template here exists because the stock WPF ones are painted for a light window: a
    TextBox drawn white with black text on top of this background is unreadable, not merely
    off-palette. Each carries its own disabled trigger, because the stock greying goes with
    the stock template, and the interval panel reading as unavailable while the feature is
    switched off is a requirement, not decoration.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces. The green cast is the one the light card already has: this is the app in
         the dark, not a different app. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1B211F" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2A302E" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#343B39" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#202624" />
    <SolidColorBrush x:Key="SurfaceDisabledBrush" Color="#232826" />

    <!-- Lines. -->
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3A423F" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#4E5854" />
    <SolidColorBrush x:Key="ControlBorderDisabledBrush" Color="#2E3634" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#333B38" />

    <!-- Text. -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EAE8" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA6A2" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5E6A66" />

    <!-- Accent, carried over from the reminder window so the two agree. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2A7A6E" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#33917F" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#21645A" />
    <SolidColorBrush x:Key="AccentFocusBrush" Color="#8FD6C6" />

    <!-- The light theme uses #B3261E, which is all but invisible against #1B211F. A dark
         theme takes the error colour up, not down. -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#F2B8B5" />

    <!--
        No Foreground SETTER here, on purpose. A setter would beat the inherited value on the
        TextBlock a ContentPresenter generates for a CheckBox caption, so a disabled checkbox
        would keep bright text while its box greyed out. Leaving the colour to inheritance
        and greying through a trigger keeps the two in step, and the trigger works precisely
        because nothing local stands in its way.
    -->
    <Style TargetType="TextBlock">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        The hints under each box. They need a colour of their own, and a local one on the
        element would block the trigger above, so the pair travels together in one style:
        inside a style a trigger outranks a setter, which is the one place this works.
    -->
    <Style x:Key="HintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />

        <!-- The caret is black by default and simply disappears on #2A302E. -->
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionOpacity" Value="0.5" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>

                    <!--
                        Focus is a border COLOUR change and never a thickness change: growing
                        the border by a pixel would nudge the text inside it every time the
                        box was tabbed into.
                    -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ControlBorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceDisabledBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ControlBorderDisabledBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Transparent, not unset: an unset Background leaves the caption
                         clickable but the gap between box and text dead. -->
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Box"
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                CornerRadius="3"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource ControlBorderBrush}"
                                BorderThickness="1">
                            <Path x:Name="Tick"
                                  Width="10"
                                  Height="8"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0,4 L 3.5,7.5 L 10,0"
                                  Stroke="#FFFFFF"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed" />
                        </Border>

                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>

                    <!-- Disabled comes LAST so it wins over checked and hover alike: inside
                         one trigger collection the later setter is the one that applies. -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ControlBorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource SurfaceDisabledBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ControlBorderDisabledBrush}" />
                            <Setter TargetName="Tick" Property="Stroke" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Two button styles rather than one. A single template would need every hover, pressed
        and focus trigger paired with a second condition asking whether this is the default
        button, because the plain trigger for each would otherwise paint the accent back to
        neutral. Two templates say the same thing in less.
    -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ControlBorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfacePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceDisabledBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ControlBorderDisabledBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{StaticResource AccentBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceDisabledBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ControlBorderDisabledBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
