<Window x:Class="MindfulnessReminder.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:MindfulnessReminder.Core;assembly=MindfulnessReminder.Core"
        Title="Mindfulness Reminder Settings"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        FontSize="13">

    <!--
        DynamicResource on the two brushes above and StaticResource everywhere below. The
        attributes on this tag are parsed before Window.Resources exists, so a StaticResource
        there has nothing to find; inside the tree it resolves normally.

        The theme is merged HERE rather than into Application.Resources. Its styles are
        implicit, and an application-wide merge would repaint BreakWindow with them, which is
        the one window that has to stay exactly as it is.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!--
        Nothing here is Topmost and nothing steals focus on a schedule: this is an ordinary
        window the user opened on purpose, unlike the reminder. It is also modeless, because
        a modal ShowDialog would disable every other window in the process, so a reminder
        falling due while the dialog sat open would appear with its Close button dead.
    -->
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Two reminders, two switches, one panel under each. The two are independent of
            each other, which the layout says by giving them the same shape: a switch, and
            under it everything that only matters while that switch is on.
        -->
        <CheckBox Grid.Row="0"
                  x:Name="UnlockCheck"
                  Content="Remind me when I unlock the computer"
                  FontWeight="SemiBold" />

        <StackPanel Grid.Row="1"
                    Margin="24,2,0,0"
                    IsEnabled="{Binding IsChecked, ElementName=UnlockCheck}">
            <!--
                One line of input: the window wraps for itself, and a line break typed here
                would only be turned into a space on save. MaxLength is the longest message
                allowed, read from Core so the dialog and the registry clamp agree.
            -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Message" VerticalAlignment="Center" />

                <TextBox Grid.Column="1"
                         x:Name="UnlockMessageBox"
                         Margin="8,0,0,0"
                         MaxLength="{x:Static core:ReminderSettings.MaxMessageLength}"
                         VerticalContentAlignment="Center"
                         Padding="4,2"
                         TextChanged="OnAnyTextChanged" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="2"
                Height="1"
                Margin="0,20,0,0"
                Background="{StaticResource SeparatorBrush}" />

        <CheckBox Grid.Row="3"
                  x:Name="EnabledCheck"
                  Margin="0,18,0,0"
                  Content="Remind me while I work"
                  FontWeight="SemiBold" />

        <!--
            Requirement: with the feature switched off the interval and the message must read
            as unavailable. Binding the whole panel to the checkbox does that for the labels,
            the boxes and the hint at once, with no code behind it to keep in step. Every
            template in the theme carries its own disabled trigger so this still shows
            through on a dark window.
        -->
        <StackPanel Grid.Row="4"
                    Margin="24,14,0,0"
                    IsEnabled="{Binding IsChecked, ElementName=EnabledCheck}">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Every" VerticalAlignment="Center" />

                <TextBox x:Name="IntervalBox"
                         Width="56"
                         Margin="8,0,8,0"
                         MaxLength="3"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         Padding="2"
                         PreviewTextInput="OnIntervalPreviewTextInput"
                         TextChanged="OnAnyTextChanged" />

                <TextBlock Text="minutes" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="HintText"
                       Margin="0,8,0,0"
                       FontSize="11"
                       Style="{StaticResource HintTextStyle}"
                       Text="Between 1 and 480 minutes. The countdown restarts when you save." />

            <!--
                One line of input: the window wraps for itself, and a line break typed here
                would only be turned into a space on save. MaxLength is the longest message
                allowed, read from Core so the dialog and the registry clamp agree.
            -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Message" VerticalAlignment="Center" />

                <TextBox Grid.Column="1"
                         x:Name="PeriodicMessageBox"
                         Margin="8,0,0,0"
                         MaxLength="{x:Static core:ReminderSettings.MaxMessageLength}"
                         VerticalContentAlignment="Center"
                         Padding="4,2"
                         TextChanged="OnAnyTextChanged" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="5"
                Height="1"
                Margin="0,20,0,0"
                Background="{StaticResource SeparatorBrush}" />

        <!--
            The two pauses sit at the TOP level, under both reminders and inside neither
            panel, because they belong to neither: they hold back whichever reminder is
            about to appear, and each reminder can be switched on without the other.
        -->
        <StackPanel Grid.Row="6" Margin="0,18,0,0">
            <CheckBox x:Name="PauseMicrophoneCheck"
                      Content="Pause while the microphone or camera is in use"
                      FontWeight="SemiBold"
                      Checked="OnPauseToggled"
                      Unchecked="OnPauseToggled" />

            <CheckBox x:Name="PauseFullScreenCheck"
                      Margin="0,10,0,0"
                      Content="Pause during full screen and presentations"
                      FontWeight="SemiBold"
                      Checked="OnPauseToggled"
                      Unchecked="OnPauseToggled" />

            <!--
                The retry gap belongs to both checkboxes, so it is available while EITHER is
                ticked. That is an OR of two bindings, which XAML cannot express without a
                converter class; OnPauseToggled sets IsEnabled instead, in one line, and the
                dialog already keeps its validation in code behind.
            -->
            <StackPanel x:Name="RetryPanel" Margin="24,14,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Check again every" VerticalAlignment="Center" />

                    <TextBox x:Name="RetryBox"
                             Width="56"
                             Margin="8,0,8,0"
                             MaxLength="3"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Padding="2"
                             PreviewTextInput="OnIntervalPreviewTextInput"
                             TextChanged="OnAnyTextChanged" />

                    <TextBlock Text="seconds" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Margin="0,8,0,0"
                           FontSize="11"
                           Style="{StaticResource HintTextStyle}"
                           Text="Between 5 and 300 seconds. The reminder waits, then looks again." />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="7"
                   x:Name="ErrorText"
                   Margin="0,14,0,0"
                   FontSize="11"
                   Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0">

            <Button x:Name="OkButton"
                    Content="Save"
                    MinWidth="88"
                    Padding="10,5"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    Click="OnSaveClick" />

            <Button x:Name="CancelButton"
                    Content="Cancel"
                    MinWidth="88"
                    Margin="10,0,0,0"
                    Padding="10,5"
                    IsCancel="True"
                    Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
